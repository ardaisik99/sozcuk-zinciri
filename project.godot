config_version=5

[application]
config/name="Sözcük Zinciri"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Kelimeler birleşir, keşif başlar."

[display]
window/size/viewport_width=432
window/size/viewport_height=900
window/size/window_width_override=432
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.9804, 0.9686, 0.9412, 1)
textures/canvas_textures/default_texture_filter=2

[gui]
theme/default_font_multichannel_signed_distance_field=false
theme/default_font_antialiasing=1

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=30
